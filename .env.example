# ─────────────────────────────────────────────────────────────────────────────
# Tasuke'26 — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore
#
# For Vercel deployment: add these in your Vercel project → Settings → Environment Variables
# For local Docker:      copy to .env, docker-compose picks it up automatically
# ─────────────────────────────────────────────────────────────────────────────


# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production


# ── MONGODB ───────────────────────────────────────────────────────────────────
# LOCAL (Docker) — used automatically in docker-compose
MONGO_URI=mongodb://mongodb:27017/safesight

# VERCEL / CLOUD — replace with your MongoDB Atlas connection strings
# You can use ONE cluster with different database names (recommended, free tier allows this)
# Replace <username>, <password>, <cluster> with your Atlas values

# SafeSight (main dashboard)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/safesight?retryWrites=true&w=majority

# MedFlow 2 — can be same cluster, different DB
# MEDFLOW_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/medflow2?retryWrites=true&w=majority

# EcoTrack — can be same cluster, different DB
# ECOTRACK_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecotrack?retryWrites=true&w=majority

# SmartRetail — can be same cluster, different DB
# SMARTRETAIL_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartretail?retryWrites=true&w=majority

# TIP: If you only set MONGO_URI, all 4 platforms will share it (different collection namespaces)


# ── AUTHENTICATION ────────────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-secure-random-secret-minimum-32-chars


# ── EMAIL ALERTS (Nodemailer) ─────────────────────────────────────────────────
# Optional — leave blank to disable email notifications for critical alerts.
# Gmail setup: https://support.google.com/accounts/answer/185833 (App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
ALERT_EMAIL_TO=security-team@yourorg.com


# ── AI ENGINE (Python / YOLOv8) ───────────────────────────────────────────────
# The AI engine runs locally only — not on Vercel.
# Used when running: python ai-engine/src/detection.py

# Find your API Key in the Dashboard UI → Edge Nodes tab
SAFESIGHT_API_KEY=082235d3-fa46-4d62-a22d-a62763502eda

# URL of the dashboard alert API
# Local Docker:  http://localhost:4000/api/alert
# Vercel:        https://your-project.vercel.app/api/alert
DASHBOARD_URL=http://localhost:4000/api/alert

# Camera Configuration
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.6
FRAME_RATE_LIMIT=15
